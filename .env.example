# Agent Harness Studio environment variables
# Copy this to .env and fill in your keys

# Firecrawl API key (get one at https://firecrawl.dev)
FIRECRAWL_API_KEY=

# Bind locally by default. Use 0.0.0.0 only behind a trusted firewall.
HARNESS_HOST=127.0.0.1
HARNESS_UI_HOST=127.0.0.1
HARNESS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional API guard. When set, requests must include either:
# Authorization: Bearer <token> or x-harness-token: <token>
HARNESS_API_TOKEN=

# Local LLM proxy (optional, auto-detected from Hermes config)
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=dummy
